# ~/.zshrc
# Zsh + Oh My Zsh + Powerlevel10k para Arch Linux.

export ZSH="$HOME/.oh-my-zsh"
export PATH="$HOME/.local/bin:$PATH"
export EDITOR="${EDITOR:-nano}"
export VISUAL="$EDITOR"

# Oh My Zsh: sin auto-update para que el arranque sea rapido en el E6400.
DISABLE_AUTO_UPDATE=true
DISABLE_UPDATE_PROMPT=true
ZSH_THEME=""

plugins=(
    git
    sudo
    extract
    colored-man-pages
    history-substring-search
)

[ -f "$ZSH/oh-my-zsh.sh" ] && source "$ZSH/oh-my-zsh.sh"

# Autosugerencias (paquete zsh-autosuggestions).
[ -f /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh ] &&
    source /usr/share/zsh/plugins/zsh-autosuggestions/zsh-autosuggestions.zsh

# Powerlevel10k.
if [ -f "$HOME/.powerlevel10k/powerlevel10k.zsh-theme" ]; then
    source "$HOME/.powerlevel10k/powerlevel10k.zsh-theme"
elif [ -f /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme ]; then
    source /usr/share/zsh-theme-powerlevel10k/powerlevel10k.zsh-theme
fi

[ -f "$HOME/.p10k.zsh" ] && source "$HOME/.p10k.zsh"

# Historial.
HISTFILE="$HOME/.zsh_history"
HISTSIZE=20000
SAVEHIST=20000
setopt HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS SHARE_HISTORY APPEND_HISTORY

# Atajos de edicion (Ctrl+flechas por palabra, Home/End, Supr).
bindkey -e
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[3~' delete-char

# zoxide: `z carpeta` para saltar a directorios usados.
if command -v zoxide >/dev/null 2>&1; then
    eval "$(zoxide init zsh)"
fi

# Aliases utiles.
alias ls='eza --icons --group-directories-first'
alias ll='eza -lh --icons --group-directories-first'
alias la='eza -lah --icons --group-directories-first'
alias lt='eza --tree --level=2'
alias tree='eza --tree'
alias cat='bat --style=plain --paging=never'
alias grep='grep --color=auto'

alias pacup='sudo pacman -Syu'
alias pacin='sudo pacman -S'
alias pacrm='sudo pacman -Rns'
alias update='sudo pacman -Syu && flatpak update'
alias flatup='flatpak update'

alias wpick='wallpaper-menu'
alias wrandom='wallpaper-menu random'
alias dots='cd "$HOME/arch-e6400"'
alias reload='source "$HOME/.zshrc"'
alias fetch='neofetch'

# Resaltado de sintaxis: debe ir al final del archivo.
[ -f /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] &&
    source /usr/share/zsh/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
